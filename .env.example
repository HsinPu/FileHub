# Copy to .env if you need custom settings. Relative paths are resolved from the project root.
# FILES_ROOT=C:/Files
# DATABASE_PATH=C:/FileHub-data/users.db
# Optional; if omitted a random persistent key is saved in config/session.key.
# SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false

# Docker Compose uses named volumes; no host folder required.
# DOCKER_PORT=9005
