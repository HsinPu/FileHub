FILEHUB_HOST=127.0.0.1
FILEHUB_PORT=3000
FILEHUB_LOG_LEVEL=info
FILEHUB_READINESS_TIMEOUT_MS=1000
FILEHUB_SHUTDOWN_TIMEOUT_MS=5000
# 反向代理／公開 HTTPS 網址須明確設定；原生 loopback 預設使用實際 port。
# FILEHUB_PUBLIC_ORIGIN=https://files.example.com
# 未設定時使用執行目錄下的 state；自訂時須使用本機絕對路徑。
# FILEHUB_STATE_DIR=/data/state
FILEHUB_SQLITE_BUSY_TIMEOUT_MS=100
FILEHUB_WORKER_POLL_INTERVAL_MS=1000
# Worker 每批最多 4 個 upload，清理／恢復需 owner 證據；範圍 1000–3600000 ms。
FILEHUB_UPLOAD_MAINTENANCE_INTERVAL_MS=60000
# 原生開發不必設定 heartbeat；Compose 固定使用各容器私有 tmpfs。
# FILEHUB_WORKER_HEARTBEAT_FILE=/run/filehub/worker.json

# Docker Compose：先 build，再啟動；同一 image 用於 migration、api、worker。
FILEHUB_IMAGE=filehub:0.40.18
FILEHUB_BIND_ADDRESS=127.0.0.1
# Compose 的預設 loopback 登入來源跟隨主機埠。
FILEHUB_HTTP_PORT=8088
# Linux 外部掛載範例：compose.mounts.example.yaml，預設唯讀。
# FILEHUB_EXTERNAL_SOURCE=/srv/filehub/external
# FILEHUB_EXTERNAL_READ_ONLY=true
