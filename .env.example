# Copy to .env if you need custom settings. Relative paths are resolved from the project root.
# FILES_ROOT=C:/Files
# DATABASE_PATH=C:/FileHub-data/users.db
# Optional; if omitted a random persistent key is saved in config/session.key.
# SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
# FILES_APP_PORT / FILES_APP_OPEN_BROWSER remain supported; FILEHUB_* takes precedence.
FILEHUB_PORT=8000
FILEHUB_OPEN_BROWSER=true

# Docker Compose host settings (container FILES_ROOT remains /files).
# DOCKER_PORT=9005
# DOCKER_FILES_DIR=C:/Users/win10/Documents/MyFiles

# Optional deployment inventory. Does not mount directories or grant account access.
# FILES_DIRECTORIES='[{"id":"shared","name":"共用資料","path":"shared"}]'
# compose.linux.yaml host paths (existing directories with UID/GID 1000 access):
# SHARED_DIR=/data/shared
# REPORTS_DIR=/mnt/reports
# DOCUMENTS_DIR=/srv/documents
