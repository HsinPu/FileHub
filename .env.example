# Copy to .env if you need custom settings. Relative paths are resolved from the project root.
# FILES_ROOT=C:/Files
# DATABASE_PATH=C:/FileHub-data/users.db
# Optional; if omitted a random persistent key is saved in config/session.key.
# SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false

# Docker Compose uses named volumes; no host folder required.
# External access on all host interfaces; use 127.0.0.1 for local-only.
DOCKER_BIND_IP=0.0.0.0
DOCKER_PORT=9005

# Optional Linux host folders: use `sh filehub.sh up -d --build --wait`.
# One folder per line. The suffix becomes its folder name under /files.
# Names: lowercase letters, numbers and underscores; start with a letter.
# Paths: literal absolute paths; quote spaces or #. No variable expansion.
# Empty values or commented lines do not add mounts.
# FILEHUB_MOUNT_nfs=/nfs
# FILEHUB_MOUNT_shared=/data/shared
# FILEHUB_MOUNT_reports=/mnt/reports
