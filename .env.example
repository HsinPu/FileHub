# Copy to .env if you need custom settings. Relative paths are resolved from the project root.
# FILES_ROOT=C:/Files
# DATABASE_PATH=C:/Files-App-data/users.db
# Optional; if omitted a random persistent key is saved in config/session.key.
# SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
FILES_APP_PORT=8000
FILES_APP_OPEN_BROWSER=true

# Docker Compose host settings (container FILES_ROOT remains /files).
# DOCKER_PORT=9005
# DOCKER_FILES_DIR=C:/Users/win10/Documents/MyFiles
