{
  "name": "filehub",
  "version": "0.40.18",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.0",
  "engines": {
    "node": "24.22.1",
    "pnpm": "12.16.0"
  },
  "scripts": {
    "typecheck": "pnpm -r --sort run typecheck && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "test:toolchain": "vitest run --project toolchain",
    "test:unit": "vitest run --project unit",
    "test:integration": "pnpm build && pnpm test:integration:run",
    "test:http": "pnpm build && vitest run --project http",
    "test:system": "pnpm build && vitest run --project system",
    "build": "node scripts/build-native.mjs && tsc --build && pnpm --filter @filehub/web run build",
    "start:api": "node --env-file-if-exists=.env apps/server/dist/server.js",
    "start:worker": "node --env-file-if-exists=.env apps/server/dist/worker.js",
    "db:generate": "pnpm --filter @filehub/server exec drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env apps/server/dist/migrate.js",
    "check": "pnpm check:project && pnpm typecheck && pnpm lint && pnpm build && pnpm test:toolchain && pnpm test:unit && pnpm test:integration:run && vitest run --project http --project system",
    "test:compose": "pnpm build && vitest run --project compose",
    "dev:web": "pnpm --filter @filehub/web run dev",
    "test:e2e": "pnpm build && node scripts/playwright.mjs test",
    "test:e2e:install": "node scripts/playwright.mjs install chromium",
    "check:project": "node scripts/check-project.mjs",
    "test:integration:run": "vitest run --project integration",
    "test:e2e:run": "node scripts/playwright.mjs test",
    "test:compose:run": "vitest run --project compose",
    "test:compose:build": "node scripts/build-image.mjs",
    "verify:core": "pnpm check && pnpm test:e2e:run",
    "verify:p0": "pnpm verify:core && pnpm test:compose:build && pnpm test:compose:run",
    "admin": "node --env-file-if-exists=.env apps/server/dist/cli.js",
    "test:nfs:build": "node scripts/verify-nfs.mjs --build-only",
    "test:nfs:run": "node scripts/verify-nfs.mjs",
    "test:nfs": "pnpm test:nfs:build && pnpm test:nfs:run",
    "maintenance": "node --env-file-if-exists=.env apps/server/dist/maintenance.js",
    "test:release": "vitest run --project release"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@filehub/server": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
